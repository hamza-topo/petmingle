# Browser-facing Laravel API URL, including its version prefix, without a trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api/v.0

# Optional browser-facing Laravel origin for public /storage media.
# When omitted, the frontend derives the origin from VITE_API_BASE_URL.
VITE_MEDIA_BASE_URL=http://localhost:8000


# Private realtime channel configuration.
# These defaults connect the browser to the Docker Soketi service.
VITE_REALTIME_ENABLED=true
VITE_PUSHER_APP_KEY=petmingle-key
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_WS_HOST=localhost
VITE_PUSHER_WS_PORT=6001
VITE_PUSHER_WS_SCHEME=ws
