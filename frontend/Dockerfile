FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL
ARG VITE_MEDIA_BASE_URL
ARG VITE_GEOCODER_BASE_URL
ARG VITE_MAP_TILE_URL
ARG VITE_MAP_TILE_ATTRIBUTION
ARG VITE_REALTIME_ENABLED=false
ARG VITE_PUSHER_APP_KEY
ARG VITE_PUSHER_APP_CLUSTER=mt1
ARG VITE_PUSHER_WS_HOST
ARG VITE_PUSHER_WS_PORT=443
ARG VITE_PUSHER_WS_SCHEME=wss
RUN VITE_API_BASE_URL="$VITE_API_BASE_URL" VITE_MEDIA_BASE_URL="$VITE_MEDIA_BASE_URL" \
    VITE_GEOCODER_BASE_URL="$VITE_GEOCODER_BASE_URL" VITE_MAP_TILE_URL="$VITE_MAP_TILE_URL" \
    VITE_MAP_TILE_ATTRIBUTION="$VITE_MAP_TILE_ATTRIBUTION" VITE_REALTIME_ENABLED="$VITE_REALTIME_ENABLED" VITE_PUSHER_APP_KEY="$VITE_PUSHER_APP_KEY" \
    VITE_PUSHER_APP_CLUSTER="$VITE_PUSHER_APP_CLUSTER" VITE_PUSHER_WS_HOST="$VITE_PUSHER_WS_HOST" \
    VITE_PUSHER_WS_PORT="$VITE_PUSHER_WS_PORT" VITE_PUSHER_WS_SCHEME="$VITE_PUSHER_WS_SCHEME" npm run build

FROM nginx:stable-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080

