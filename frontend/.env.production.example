# Copy to .env.production.local, then provide real HTTPS browser URLs before building.
# Empty API intentionally fails a production build; no deployment domain is assumed.
VITE_API_BASE_URL=
# Optional HTTPS media origin; blank derives the API origin.
VITE_MEDIA_BASE_URL=
# Enable only after deploying the private realtime service over WSS.
VITE_REALTIME_ENABLED=false
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_WS_HOST=
VITE_PUSHER_WS_PORT=443
VITE_PUSHER_WS_SCHEME=wss
