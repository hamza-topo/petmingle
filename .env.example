APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
# Comma-separated exact frontend origins; replace with HTTPS origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
APP_ADMIN_URL=http://admin.petspat.test
APP_API_URL=http://petspat.test
PINTEREST_URL=https://www.pinterest.com/petspat/
PINTEREST_URL='#'

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=petmingle
DB_USERNAME=petmingle
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3306





CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_CONTACT_US=contact@petmingle.test
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@petmingle.test
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BROADCAST_DRIVER=pusher
# Local Docker defaults use the bundled Pusher-compatible Soketi service.
# For Pusher Cloud, use real credentials and leave PUSHER_HOST empty.
PUSHER_APP_ID=petmingle
PUSHER_APP_KEY=petmingle-key
PUSHER_APP_SECRET=petmingle-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
FORWARD_PUSHER_PORT=6001

#GITHUB
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

#GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

#FACEBOOK
FACEBOOk_CLIENT_ID=XXXXXXXXX
FACEBOOk_CLIENT_SECRET=XXXXXXX
FACEBOOk_REDIRECT_URI=
